# -----------------------------------------------------------------------------
# Bondzi web — environment variables
# -----------------------------------------------------------------------------
# Copy to `.env.local` for local dev, and set the same names in your deploy
# target (Vercel Project Settings → Environment Variables) for prod.
# -----------------------------------------------------------------------------

# The public API endpoint the web app talks to. Same URL the mobile app hits.
# Falls back to https://api.bondzi.online/api/v1 if unset — safe default for
# production but override in .env.local when developing against a local backend.
NEXT_PUBLIC_API_URL=https://api.bondzi.online/api/v1

# NextAuth v5 secret. Used to sign the session JWT + encrypt callback URLs.
# Generate with:
#   openssl rand -base64 32
# NEVER commit the real value. If it leaks, rotate immediately — every existing
# session becomes invalid but the users just have to sign back in.
NEXTAUTH_SECRET=replace-me-with-openssl-rand-base64-32-output

# The canonical URL NextAuth uses to construct callback links. Only required
# outside Vercel-style auto-detection.
#   Local dev:  http://localhost:3000
#   Production: https://app.bondzi.online
NEXTAUTH_URL=http://localhost:3000

# Deployment marker consumed by lib/env.ts.  One of: development | preview | production.
NEXT_PUBLIC_APP_ENV=development
